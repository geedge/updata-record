{
  "type": "kafka",
  "dataSchema": {
    "dataSource": "top_urls_log",
    "parser": {
      "type": "string",
      "parseSpec": {
        "format": "json",
        "timestampSpec": {
          "column": "stat_time",
          "format": "iso"
        },
        "dimensionsSpec": {
          "dimensions": [
	   "url"
          ]
        }
      }
    },
    "metricsSpec" : [
        { "type" : "longSum", "name" : "session_num", "fieldName" : "session_num" }
  ],
    "granularitySpec": {
      "type": "uniform",
      "segmentGranularity": "DAY",
      "queryGranularity": {"type": "period", "period": "PT5M", "timeZone": "Asia/Hong_Kong"},
      "rollup": true
    },
    "transformSpec" :{}
  },
  "tuningConfig": {
    "type": "kafka",
    "maxRowsPerSegment": 5000000,
    "reportParseExceptions": false
  },
  "ioConfig": {
    "topic": "TOP-URLS",
    "taskCount": 1,
    "replicas": 1,
    "taskDuration": "PT1H",
    "completionTimeout": "PT30M",
    "consumerProperties": {
      "bootstrap.servers": "kafkabootstrap",
      "sasl.mechanism": "PLAIN",
      "security.protocol": "SASL_PLAINTEXT",
      "sasl.jaas.config": "org.apache.kafka.common.security.scram.ScramLoginModule required username=\"admin\" password=\"galaxy2019\";"
    }
  }
}
