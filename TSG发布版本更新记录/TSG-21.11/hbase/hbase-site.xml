<!-- hbase hbase-site.xml 新增以下配置,集成Phoenix ，修改后复制一份到phoenix /bin目录下-->

<configuration>
  <property>
    <name>phoenix.schema.isNamespaceMappingEnabled</name>
    <value>true</value>
  </property>
  <property>
    <name>phoenix.schema.mapSystemTablesToNamespace</name>
    <value>true</value>
  </property>
</configuration>
