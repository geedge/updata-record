{
  "type": "record",
  "name": "top_client_ip_log",
  "namespace": "druid",
  "doc": {
    "partition_key": "__time",
    "functions": {
      "$ref": "public_schema_info.json#/functions"
    },
    "schema_query": {
      "references": {
        "$ref": "public_schema_info.json#/schema_query/references"
      }
    }
  },
  "fields": [
    {
      "name": "__time",
      "label": "Time",
      "type": "string",
      "doc": {
        "constraints": {
          "type": "timestamp"
        }
      }
    },
    {
      "name": "data_center",
      "label": "Data Center",
      "type": "string",
      "doc": {
        "constraints": {
          "operator_functions": "=,!=,in,not in"
        },
        "data": {
          "$ref": "device_tag.json#",
          "key": "$[?(@.tagType=='data_center')].subTags.[?(@.tagType=='data_center')]['tagValue']",
          "value": "$[?(@.tagType=='data_center')].subTags.[?(@.tagType=='data_center')]['tagName']"
        }
      }
    },
    {
      "name": "device_group",
      "label": "Device Group",
      "type": "string",
      "doc": {
        "constraints": {
          "operator_functions": "=,!=,in,not in"
        },
        "data": {
          "$ref": "device_tag.json#",
          "key": "$[?(@.tagType=='device_group')].subTags.[?(@.tagType=='device_group')]['tagValue']",
          "value": "$[?(@.tagType=='device_group')].subTags.[?(@.tagType=='device_group')]['tagName']"
        }
      }
    },
    {
      "name": "source",
      "label": "Client IP",
      "type": "string"
    },
    {
      "name": "session_num",
      "label": "Sessions",
      "type": "long"
    },
    {
      "name": "c2s_byte_num",
      "label": "Bytes Sent",
      "type": "long"
    },
    {
      "name": "s2c_byte_num",
      "label": "Bytes Received",
      "type": "long"
    },
    {
      "name": "c2s_pkt_num",
      "label": "Packets Sent",
      "type": "long"
    },
    {
      "name": "s2c_pkt_num",
      "label": "Packets Received",
      "type": "long"
    },
    {
      "name": "order_by",
      "label": "Order By",
      "type": "string"
    }
  ]
}